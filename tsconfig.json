{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun-types"]
  },
  "include": [
    "server/index.ts",
    "server/app/**/*.ts",
    "scripts/**/*.ts",
    "src/api/**/*.ts",
    "src/hooks/**/*.ts",
    "src/**/*.tsx"
  ]
}
